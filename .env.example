# Copy to .env.local for local development; do not commit real credentials.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Must contain {u}; use the email domain configured for your Supabase Auth setup.
VITE_AUTH_EMAIL_TEMPLATE={u}@your-auth-domain.com

# Use a real address you monitor for Nominatim contact details.
VITE_NOMINATIM_CONTACT_EMAIL=you@your-domain.com
