# Copy to .env.local for local development; do not commit real credentials.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Must contain {u}; use the email domain configured for your Supabase Auth setup.
VITE_AUTH_EMAIL_TEMPLATE={u}@gmail.com

# Use a real address you monitor for Nominatim contact details.
VITE_NOMINATIM_CONTACT_EMAIL=you@your-domain.com

# Optional: TfL Journey Planner key. Without it, public transport routing stays unavailable.
# Vite client variables are included in the browser build; use a server-side proxy if the key
# must remain private. TfL keys are sent as app_key and are subject to the selected API plan.
VITE_TFL_APP_KEY=

# Optional: use a self-hosted Valhalla pedestrian routing endpoint instead of the community demo.
VITE_VALHALLA_URL=https://valhalla1.openstreetmap.de/route
